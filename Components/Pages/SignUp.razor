@page "/sign-up"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation

<PageTitle>Sign Up — Sprout</PageTitle>

<div class="auth-wrapper reverse @(isLeaving ? "swap-exit" : "")">
    <!-- Left Hero Image Panel -->
    <div class="auth-hero-panel">
        <img class="hero-photo"
             src="https://images.unsplash.com/photo-1623982203080-2881a8aeb1ec?auto=format&fit=crop&w=1400&q=80"
             alt="Morning light falling across a windowsill crowded with young potted seedlings" />
        <div class="hero-backdrop"></div>

        <div class="hero-layer">
            <NavLink href="/" class="hero-brand">
                <span class="brand-dot"></span>
                <span>Sprout</span>
            </NavLink>

            <div class="hero-feature-content">
                <div class="hero-stats">
                    <span class="stat-number">12,400+</span>
                    <span class="stat-label">gardens growing</span>
                </div>

                <div class="feature-bullets">
                    <div class="bullet-row">
                        <span class="check-icon">✓</span>
                        <span>Smart watering reminders</span>
                    </div>
                    <div class="bullet-row">
                        <span class="check-icon">✓</span>
                        <span>Season-by-season tracking</span>
                    </div>
                    <div class="bullet-row">
                        <span class="check-icon">✓</span>
                        <span>A community to grow with</span>
                    </div>
                </div>

                <div class="testimonial-card">
                    <img src="https://images.unsplash.com/photo-1610930815255-0c92968e87a2?auto=format&fit=crop&w=480&q=80"
                         alt="Seedling garden bed" />
                    <p>“Day 1 — first seeds planted.”</p>
                </div>
            </div>

            <p class="hero-bottom-text">Every category has room to grow.</p>
        </div>
    </div>

    <!-- Right Form Section -->
    <div class="auth-form-panel">
        <header class="auth-header">
            <NavLink href="/" class="mobile-brand">
                <span class="brand-dot"></span>
                <span>Sprout</span>
            </NavLink>
            <div class="header-links">
                <a href="sign-in" class="nav-alt" @onclick='() => NavigateWithSwap("sign-in")' @onclick:preventDefault="true">Sign in</a>
                <NavLink href="/" class="nav-alt">Back to home</NavLink>
            </div>
        </header>

        <div class="auth-box-center">
            <div class="auth-box">
                <div class="auth-heading">
                    <h1>Plant your garden</h1>
                    <p>Create an account to start tracking your first season.</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mt-4 p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-600 text-sm flex items-center gap-2">
                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span>@errorMessage</span>
                    </div>
                }

                <!-- Registration Form -->
                <EditForm Model="@signUpModel" OnValidSubmit="HandleSubmit" class="input-form mt-6">
                    <DataAnnotationsValidator />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="field-wrap">
                            <label for="first-name">First name</label>
                            <InputText id="first-name"
                                       disabled="@isSubmitting"
                                       class="form-input transition-all disabled:opacity-60"
                                       @bind-Value="signUpModel.FirstName"
                                       placeholder="Alex" />
                            <ValidationMessage For="@(() => signUpModel.FirstName)" />
                        </div>

                        <div class="field-wrap">
                            <label for="last-name">Last name</label>
                            <InputText id="last-name"
                                       disabled="@isSubmitting"
                                       class="form-input transition-all disabled:opacity-60"
                                       @bind-Value="signUpModel.LastName"
                                       placeholder="Chen" />
                            <ValidationMessage For="@(() => signUpModel.LastName)" />
                        </div>
                    </div>

                    <div class="field-wrap">
                        <label for="email">Email address</label>
                        <InputText id="email" 
                                   disabled="@isSubmitting"
                                   class="form-input transition-all disabled:opacity-60" 
                                   @bind-Value="signUpModel.Email" 
                                   placeholder="you@domain.com" />
                        <ValidationMessage For="@(() => signUpModel.Email)" />
                    </div>

                    <!-- Password Field with Suppressed Native Reveal and Left-Adjusted Toggle -->
                    <div class="field-wrap">
                        <div class="flex justify-between items-center">
                            <label for="password">Password</label>
                            @if (!string.IsNullOrEmpty(signUpModel.Password))
                            {
                                <span class="text-xs font-semibold @GetStrengthColorClass()">
                                    @GetStrengthLabel()
                                </span>
                            }
                        </div>
                        <div class="relative flex items-center w-full">
                            <input id="password" 
                                   type="@(showPassword ? "text" : "password")" 
                                   disabled="@isSubmitting"
                                   class="form-input w-full pr-12 transition-all disabled:opacity-60 [&::-ms-reveal]:hidden [&::-ms-clear]:hidden" 
                                   value="@signUpModel.Password"
                                   @oninput="OnPasswordInput"
                                   placeholder="At least 8 characters" />
                            <button type="button" 
                                    tabindex="-1"
                                    class="absolute right-3.5 inset-y-0 flex items-center justify-center cursor-pointer bg-transparent border-0 outline-none z-20"
                                    style="color: @(showPassword ? "#2ecb72" : "#94a3b8");"
                                    @onclick="() => showPassword = !showPassword">
                                <svg width="20" 
                                     height="20" 
                                     viewBox="0 0 24 24" 
                                     fill="none" 
                                     stroke="currentColor" 
                                     stroke-width="2.2" 
                                     stroke-linecap="round" 
                                     stroke-linejoin="round"
                                     style="pointer-events: none; display: block;">
                                    <path d="M4 14a8 8 0 0 1 16 0" />
                                    <circle cx="12" cy="14" r="3.2" />
                                </svg>
                            </button>
                        </div>

                        <!-- Progress Bar (5 criteria = 20% each) -->
                        <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden mt-1.5">
                            <div class="h-full transition-all duration-300 @GetStrengthBarClass()"
                                 style="width: @(passwordScore * 20)%"></div>
                        </div>

                        <!-- Expanded Live Password Requirements Checklist -->
                        <div class="mt-2.5 grid grid-cols-2 gap-x-2 gap-y-1 text-[0.75rem]">
                            <div class="flex items-center gap-1.5 @(hasMinLength ? "text-emerald-600 font-medium" : "text-slate-400")">
                                <span>@(hasMinLength ? "✓" : "○")</span>
                                <span>8+ characters</span>
                            </div>
                            <div class="flex items-center gap-1.5 @(hasUpper ? "text-emerald-600 font-medium" : "text-slate-400")">
                                <span>@(hasUpper ? "✓" : "○")</span>
                                <span>Uppercase letter</span>
                            </div>
                            <div class="flex items-center gap-1.5 @(hasLower ? "text-emerald-600 font-medium" : "text-slate-400")">
                                <span>@(hasLower ? "✓" : "○")</span>
                                <span>Lowercase letter</span>
                            </div>
                            <div class="flex items-center gap-1.5 @(hasNumber ? "text-emerald-600 font-medium" : "text-slate-400")">
                                <span>@(hasNumber ? "✓" : "○")</span>
                                <span>One number</span>
                            </div>
                            <div class="flex items-center gap-1.5 col-span-2 @(hasSpecial ? "text-emerald-600 font-medium" : "text-slate-400")">
                                <span>@(hasSpecial ? "✓" : "○")</span>
                                <span>Special character (!@@#$%^&*)</span>
                            </div>
                        </div>

                        <ValidationMessage For="@(() => signUpModel.Password)" />
                    </div>

                    <button type="submit" disabled="@isSubmitting" class="btn-submit flex items-center justify-center gap-2 mt-4 disabled:opacity-75 disabled:cursor-not-allowed">
                        @if (isSubmitting)
                        {
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Planting your garden...</span>
                        }
                        else
                        {
                            <span>Plant your garden</span>
                        }
                    </button>
                </EditForm>

                <p class="auth-footer-prompt">
                    Already have an account? <a href="sign-in" @onclick='() => NavigateWithSwap("sign-in")' @onclick:preventDefault="true">Sign in</a>
                </p>
            </div>
        </div>

        <footer class="legal-footer">
            <p>© 2026 Sprout · <a href="#">Privacy Policy</a></p>
        </footer>
    </div>
</div>

@code {
    private SignUpForm signUpModel = new();
    private bool isLeaving = false;
    private bool showPassword = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    // Password rules live in Models/Forms/PasswordStrength.cs
    private PasswordStrength strength = PasswordStrength.Evaluate(string.Empty);
    private int passwordScore => strength.Score;
    private bool hasMinLength => strength.HasMinLength;
    private bool hasUpper => strength.HasUpper;
    private bool hasLower => strength.HasLower;
    private bool hasNumber => strength.HasNumber;
    private bool hasSpecial => strength.HasSpecial;

    private void OnPasswordInput(ChangeEventArgs e)
    {
        signUpModel.Password = e.Value?.ToString() ?? string.Empty;
        strength = PasswordStrength.Evaluate(signUpModel.Password);
    }

    private string GetStrengthLabel() => strength.Label;

    private string GetStrengthColorClass() => passwordScore switch
    {
        1 or 2 => "text-rose-500",
        3 or 4 => "text-amber-500",
        5 => "text-emerald-600",
        _ => ""
    };

    private string GetStrengthBarClass() => passwordScore switch
    {
        1 or 2 => "bg-rose-500",
        3 or 4 => "bg-amber-500",
        5 => "bg-[#2ecb72]",
        _ => "bg-transparent"
    };

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (passwordScore < 3)
        {
            errorMessage = "Please choose a stronger password before proceeding.";
            return;
        }

        isSubmitting = true;
        await Task.Delay(1200);

        if (signUpModel.Email.Equals("taken@test.com", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "An account with this email address already exists.";
            isSubmitting = false;
            return;
        }

        isSubmitting = false;
        Navigation.NavigateTo("/sign-in");
    }

    private async Task NavigateWithSwap(string url)
    {
        isLeaving = true;
        StateHasChanged();
        await Task.Delay(450);
        Navigation.NavigateTo(url);
    }

}