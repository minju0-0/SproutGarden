@page "/sign-in"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation

<PageTitle>Sign In — Sprout</PageTitle>

<div class="auth-wrapper @(isLeaving ? "swap-exit" : "")">
    <!-- Left Hero Image Panel -->
    <div class="auth-hero-panel">
        <img class="hero-photo"
             src="https://images.unsplash.com/photo-1610930815255-0c92968e87a2?auto=format&fit=crop&w=1400&q=80"
             alt="A well-tended garden bed in the warm light of late afternoon" />
        <div class="hero-backdrop"></div>

        <div class="hero-layer">
            <NavLink href="/" class="hero-brand">
                <span class="brand-dot"></span>
                <span>Sprout</span>
            </NavLink>

            <div class="hero-feature-content">
                <div class="hero-stats">
                    <span class="stat-number">86%</span>
                    <span class="stat-label">still thriving after 90 days</span>
                </div>

                <div class="feature-bullets">
                    <div class="bullet-row">
                        <span class="check-icon">✓</span>
                        <span>Your personalized care calendar</span>
                    </div>
                    <div class="bullet-row">
                        <span class="check-icon">✓</span>
                        <span>Photo journal &amp; timeline</span>
                    </div>
                    <div class="bullet-row">
                        <span class="check-icon">✓</span>
                        <span>Weather-based watering alerts</span>
                    </div>
                </div>

                <div class="testimonial-card">
                    <img src="https://images.unsplash.com/photo-1623982203080-2881a8aeb1ec?auto=format&fit=crop&w=480&q=80"
                         alt="Balcony tomatoes" />
                    <p>“Day 42 — first blooms on the balcony tomatoes.”</p>
                </div>
            </div>

            <p class="hero-bottom-text">Welcome back — your garden missed you.</p>
        </div>
    </div>

    <!-- Right Form Section -->
    <div class="auth-form-panel">
        <header class="auth-header">
            <NavLink href="/" class="mobile-brand">
                <span class="brand-dot"></span>
                <span>Sprout</span>
            </NavLink>
            <div class="header-links">
                <a href="sign-up" class="nav-alt" @onclick='() => NavigateWithSwap("sign-up")' @onclick:preventDefault="true">Sign up</a>
                <NavLink href="/" class="nav-alt">Back to home</NavLink>
            </div>
        </header>

        <div class="auth-box-center">
            <div class="auth-box">
                <div class="auth-heading">
                    <h1>Welcome back</h1>
                    <p>Sign in to check on your garden.</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mt-4 p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-600 text-sm flex items-center gap-2">
                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span>@errorMessage</span>
                    </div>
                }

                <!-- Form -->
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit" class="input-form mt-6">
                    <DataAnnotationsValidator />

                    <div class="field-wrap">
                        <label for="email">Email address</label>
                        <InputText id="email" 
                                   disabled="@isSubmitting"
                                   class="form-input transition-all disabled:opacity-60" 
                                   @bind-Value="formModel.Email" 
                                   placeholder="you@domain.com" />
                        <ValidationMessage For="@(() => formModel.Email)" />
                    </div>

                    <div class="field-wrap">
                        <div class="flex justify-between items-center">
                            <label for="password">Password</label>
                            <a href="javascript:void(0)" class="text-xs text-[#2ecb72] hover:underline">Forgot password?</a>
                        </div>
                        <div class="relative flex items-center w-full">
                            <input id="password"
                                   type="@(showPassword ? "text" : "password")"
                                   disabled="@isSubmitting"
                                   class="form-input w-full pr-12 transition-all disabled:opacity-60 [&::-ms-reveal]:hidden [&::-ms-clear]:hidden" 
                                   value="@formModel.Password"
                                   @oninput="(e) => formModel.Password = e.Value?.ToString() ?? string.Empty"
                                   placeholder="••••••••" />
                            <button type="button" 
                                    tabindex="-1"
                                    class="absolute right-3.5 inset-y-0 flex items-center justify-center cursor-pointer bg-transparent border-0 outline-none z-20"
                                    style="color: @(showPassword ? "#2ecb72" : "#94a3b8");"
                                    @onclick="() => showPassword = !showPassword">
                                <svg width="20" 
                                     height="20" 
                                     viewBox="0 0 24 24" 
                                     fill="none" 
                                     stroke="currentColor" 
                                     stroke-width="2.2" 
                                     stroke-linecap="round" 
                                     stroke-linejoin="round"
                                     style="pointer-events: none; display: block;">
                                    <path d="M4 14a8 8 0 0 1 16 0" />
                                    <circle cx="12" cy="14" r="3.2" />
                                </svg>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => formModel.Password)" />
                    </div>

                    <button type="submit" disabled="@isSubmitting" class="btn-submit flex items-center justify-center gap-2 mt-2 disabled:opacity-75 disabled:cursor-not-allowed">
                        @if (isSubmitting)
                        {
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Checking account...</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                        }
                    </button>
                </EditForm>

                <p class="auth-footer-prompt">
                    New to Sprout? <a href="sign-up" @onclick='() => NavigateWithSwap("sign-up")' @onclick:preventDefault="true">Create an account</a>
                </p>
            </div>
        </div>

        <footer class="legal-footer">
            <p>© 2026 Sprout · <a href="#">Privacy Policy</a></p>
        </footer>
    </div>
</div>

@code {
    private SignInForm formModel = new();
    private bool isLeaving = false;
    private bool showPassword = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        await Task.Delay(1000);

        if (formModel.Email.Equals("fail@test.com", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Invalid email or password. Please try again.";
            isSubmitting = false;
            return;
        }

        isSubmitting = false;
        Navigation.NavigateTo("/");
    }

    private async Task NavigateWithSwap(string url)
    {
        isLeaving = true;
        StateHasChanged();
        await Task.Delay(450);
        Navigation.NavigateTo(url);
    }

}